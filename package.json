{
  "name": "scanbox",
  "version": "1.1.0",
  "description": "A Windows desktop app for scanning and batch cropping family photos",
  "main": "main.js",
  "private": true,
  "scripts": {
    "test": "node --test image-input.test.js image-adjustments.test.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.scanbox.photos",
    "productName": "Scanbox",
    "asar": true,
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Scanbox-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
